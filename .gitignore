# Generated by Cargo / rustc
/target/

# Backup files generated by rustc
**/*.rs.bk
*.bk

# Remove Cargo.lock from source control if building a library.
# This project ships a binary engine (xiaopeng-engine), so Cargo.lock is
# intentionally committed for reproducible builds. Do NOT ignore it.

# MSVC / Windows specific
*.pdb

# IDE / editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
